  "info": {
    "description": "An open registry of dated facts about what third-party HTTP APIs, SDKs and CLIs actually return, established by deterministic probes (no language model in the verification path). No authentication. Start with `POST /v0/check` when a call to a third-party API fails; every fact also has a page at https://apifacts.dev/<service>/<slug>. MCP (stdio): `uvx --from 'apifacts[mcp]' apifacts mcp`, described at https://apifacts.dev/.well-known/mcp.json.",
    "summary": "Verified facts about machine interfaces for AI agents (data CC BY 4.0).",
    "title": "apifacts",
    "version": "v0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz"
      }
    },
    "/v0/check": {
      "post": {
        "description": "Send the request that failed (`target`: method and URL) and, if you have it, what came back (`error`: HTTP status and the first 2 KB of the body or exception text). The answer lists the matching facts (by normalized error string on that endpoint, else by status, else the service's rate-limit and availability facts), each with typed fixes (a closed vocabulary: set_header, retry_after_header, use_endpoint, ...), its verification status and dates. Never empty: `unknown` says why nothing matched (unregistered target, no fact for the signal, no extractable signal).\n\nPrivacy: query string and fragment are dropped before matching; a call with an `error` on a registered template is stored as one normalized observation (no body, headers, query or raw IP). Do not send credentials: the body excerpt is for the vendor's error message.",
        "operationId": "check_v0_check_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          }
        },
        "summary": "Look up known facts for a failed API call"
      }
    },
    "/v0/facts/{service}": {
      "get": {
        "operationId": "facts_v0_facts__service__get",
        "parameters": [
          {
            "in": "path",
            "name": "service",
            "required": true,
            "schema": {
              "title": "Service",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FactsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
