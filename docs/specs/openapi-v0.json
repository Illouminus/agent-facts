{
  "components": {
    "schemas": {
      "BackoffExponential": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "backoff_exponential",
            "title": "Action",
            "type": "string"
          },
          "base_ms": {
            "maximum": 600000.0,
            "minimum": 1.0,
            "title": "Base Ms",
            "type": "integer"
          },
          "factor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "gt": 1,
            "le": 10,
            "title": "Factor"
          },
          "jitter": {
            "title": "Jitter",
            "type": "boolean"
          },
          "max_attempts": {
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Max Attempts",
            "type": "integer"
          },
          "max_ms": {
            "maximum": 3600000.0,
            "minimum": 1.0,
            "title": "Max Ms",
            "type": "integer"
          }
        },
        "required": [
          "action",
          "base_ms",
          "factor",
          "max_ms",
          "max_attempts",
          "jitter"
        ],
        "title": "BackoffExponential",
        "type": "object"
      },
      "CheckContext": {
        "additionalProperties": false,
        "properties": {
          "env_hint": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Env"
              },
              {
                "type": "null"
              }
            ]
          },
          "sdk": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SdkContext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "CheckContext",
        "type": "object"
      },
      "CheckError": {
        "additionalProperties": false,
        "properties": {
          "body_excerpt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "First 2 KB of the error body or exception text (longer input is cut).",
            "title": "Body Excerpt"
          },
          "status": {
            "anyOf": [
              {
                "maximum": 599.0,
                "minimum": 100.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          }
        },
        "title": "CheckError",
        "type": "object"
      },
      "CheckRequest": {
        "additionalProperties": false,
        "description": "Request = contribution: if `target` matches a registered template and `error` carries a\nsignal, a normalized observation is stored (no body, headers, query or raw IP).",
        "properties": {
          "context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CheckContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CheckError"
              },
              {
                "type": "null"
              }
            ]
          },
          "target": {
            "$ref": "#/components/schemas/CheckTarget"
          }
        },
        "required": [
          "target"
        ],
        "title": "CheckRequest",
        "type": "object"
      },
      "CheckResponse": {
        "description": "Never empty: all six keys are always present.",
        "properties": {
          "facts": {
            "items": {
              "$ref": "#/components/schemas/FactOut"
            },
            "title": "Facts",
            "type": "array"
          },
          "matched_template": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MatchedTemplate"
              },
              {
                "type": "null"
              }
            ]
          },
          "observed": {
            "$ref": "#/components/schemas/Observed"
          },
          "registry": {
            "$ref": "#/components/schemas/RegistryInfo"
          },
          "service": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Service"
          },
          "unknown": {
            "$ref": "#/components/schemas/Unknown"
          }
        },
        "required": [
          "service",
          "matched_template",
          "facts",
          "observed",
          "unknown",
          "registry"
        ],
        "title": "CheckResponse",
        "type": "object"
      },
      "CheckTarget": {
        "additionalProperties": false,
        "properties": {
          "method": {
            "anyOf": [
              {
                "enum": [
                  "GET",
                  "HEAD",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE",
                  "OPTIONS"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "HTTP method; required when `url` is an http(s) URL with a path.",
            "title": "Method"
          },
          "url": {
            "description": "An http(s) URL, a bare host, or a `pypi:<pkg>@<ver>` / `npm:<pkg>@<ver>` locator. Query and fragment are dropped before matching and never stored.",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "CheckTarget",
        "type": "object"
      },
      "Dimensions": {
        "additionalProperties": false,
        "properties": {
          "account_state": {
            "default": "any",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$",
            "title": "Account State",
            "type": "string"
          },
          "env": {
            "$ref": "#/components/schemas/Env"
          },
          "plan": {
            "default": "any",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$",
            "title": "Plan",
            "type": "string"
          },
          "region": {
            "default": "any",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$",
            "title": "Region",
            "type": "string"
          }
        },
        "required": [
          "env"
        ],
        "title": "Dimensions",
        "type": "object"
      },
      "EnableInDashboard": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "enable_in_dashboard",
            "title": "Action",
            "type": "string"
          },
          "setting_key": {
            "pattern": "^[A-Za-z0-9_.\\[\\]*$/-]{1,128}$",
            "title": "Setting Key",
            "type": "string"
          },
          "vendor_doc_url": {
            "maxLength": 512,
            "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[^\\s]*)?$",
            "title": "Vendor Doc Url",
            "type": "string"
          }
        },
        "required": [
          "action",
          "setting_key",
          "vendor_doc_url"
        ],
        "title": "EnableInDashboard",
        "type": "object"
      },
      "EncodeAs": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "encode_as",
            "title": "Action",
            "type": "string"
          },
          "encoding": {
            "enum": [
              "base64",
              "url",
              "json_string",
              "rfc3339"
            ],
            "title": "Encoding",
            "type": "string"
          },
          "field": {
            "pattern": "^[A-Za-z0-9_.\\[\\]*$/-]{1,128}$",
            "title": "Field",
            "type": "string"
          }
        },
        "required": [
          "action",
          "field",
          "encoding"
        ],
        "title": "EncodeAs",
        "type": "object"
      },
      "Env": {
        "enum": [
          "prod",
          "sandbox"
        ],
        "title": "Env",
        "type": "string"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "field"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Evidence": {
        "additionalProperties": false,
        "properties": {
          "confirmations": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confirmations"
          },
          "first_seen": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
            "title": "First Seen",
            "type": "string"
          },
          "last_confirmed": {
            "anyOf": [
              {
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Confirmed"
          },
          "observations": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observations"
          },
          "official_url": {
            "anyOf": [
              {
                "maxLength": 512,
                "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[^\\s]*)?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Official Url"
          },
          "probe": {
            "anyOf": [
              {
                "pattern": "^af:[a-z0-9][a-z0-9-]{0,63}:probe:[a-z0-9][a-z0-9-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Probe"
          },
          "stale_counter": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stale Counter"
          },
          "vantages": {
            "anyOf": [
              {
                "items": {
                  "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vantages"
          }
        },
        "required": [
          "first_seen"
        ],
        "title": "Evidence",
        "type": "object"
      },
      "FactOut": {
        "additionalProperties": false,
        "description": "A fact as stored in `facts/<service>/<slug>.yaml`, plus its fixes in English.",
        "properties": {
          "claim": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Claim",
            "type": "string"
          },
          "dimensions": {
            "$ref": "#/components/schemas/Dimensions"
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence"
          },
          "fixes": {
            "items": {
              "discriminator": {
                "mapping": {
                  "backoff_exponential": "#/components/schemas/BackoffExponential",
                  "enable_in_dashboard": "#/components/schemas/EnableInDashboard",
                  "encode_as": "#/components/schemas/EncodeAs",
                  "none_known": "#/components/schemas/NoneKnown",
                  "paginate_with": "#/components/schemas/PaginateWith",
                  "pin_sdk_version": "#/components/schemas/PinSdkVersion",
                  "reduce_payload": "#/components/schemas/ReducePayload",
                  "remove_param": "#/components/schemas/RemoveParam",
                  "request_scope": "#/components/schemas/RequestScope",
                  "retry_after_header": "#/components/schemas/RetryAfterHeader",
                  "set_header": "#/components/schemas/SetHeader",
                  "set_param": "#/components/schemas/SetParam",
                  "switch_env": "#/components/schemas/SwitchEnv",
                  "upgrade_sdk": "#/components/schemas/UpgradeSdk",
                  "use_endpoint": "#/components/schemas/UseEndpoint",
                  "wait_for_state": "#/components/schemas/WaitForState"
                },
                "propertyName": "action"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/RetryAfterHeader"
                },
                {
                  "$ref": "#/components/schemas/BackoffExponential"
                },
                {
                  "$ref": "#/components/schemas/SetHeader"
                },
                {
                  "$ref": "#/components/schemas/SetParam"
                },
                {
                  "$ref": "#/components/schemas/RemoveParam"
                },
                {
                  "$ref": "#/components/schemas/UseEndpoint"
                },
                {
                  "$ref": "#/components/schemas/PaginateWith"
                },
                {
                  "$ref": "#/components/schemas/PinSdkVersion"
                },
                {
                  "$ref": "#/components/schemas/UpgradeSdk"
                },
                {
                  "$ref": "#/components/schemas/SwitchEnv"
                },
                {
                  "$ref": "#/components/schemas/RequestScope"
                },
                {
                  "$ref": "#/components/schemas/WaitForState"
                },
                {
                  "$ref": "#/components/schemas/EnableInDashboard"
                },
                {
                  "$ref": "#/components/schemas/ReducePayload"
                },
                {
                  "$ref": "#/components/schemas/EncodeAs"
                },
                {
                  "$ref": "#/components/schemas/NoneKnown"
                }
              ]
            },
            "maxItems": 3,
            "minItems": 1,
            "title": "Fixes",
            "type": "array"
          },
          "fixes_rendered": {
            "items": {
              "type": "string"
            },
            "title": "Fixes Rendered",
            "type": "array"
          },
          "id": {
            "pattern": "^af:[a-z0-9][a-z0-9-]{0,63}:[a-z0-9][a-z0-9-]{0,127}$",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/Kind"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "service": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "title": "Service",
            "type": "string"
          },
          "signal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Signal"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "target": {
            "$ref": "#/components/schemas/Target"
          }
        },
        "required": [
          "id",
          "service",
          "kind",
          "target",
          "claim",
          "dimensions",
          "fixes",
          "status",
          "evidence",
          "provenance",
          "fixes_rendered"
        ],
        "title": "FactOut",
        "type": "object"
      },
      "FactsResponse": {
        "properties": {
          "facts": {
            "items": {
              "$ref": "#/components/schemas/FactOut"
            },
            "title": "Facts",
            "type": "array"
          },
          "registry": {
            "$ref": "#/components/schemas/RegistryInfo"
          },
          "service": {
            "title": "Service",
            "type": "string"
          }
        },
        "required": [
          "service",
          "facts",
          "registry"
        ],
        "title": "FactsResponse",
        "type": "object"
      },
      "Health": {
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "probes_last_run": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Probes Last Run"
          },
          "registry_version": {
            "title": "Registry Version",
            "type": "string"
          }
        },
        "required": [
          "ok",
          "registry_version",
          "probes_last_run"
        ],
        "title": "Health",
        "type": "object"
      },
      "HistoryEntry": {
        "additionalProperties": false,
        "properties": {
          "by": {
            "pattern": "^(bot|producer:[a-z0-9][a-z0-9-]{0,63}|human:[A-Za-z0-9][A-Za-z0-9-]{0,38})$",
            "title": "By",
            "type": "string"
          },
          "change": {
            "pattern": "^[a-z][a-z0-9_:.-]{0,63}$",
            "title": "Change",
            "type": "string"
          },
          "date": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "title": "Date",
            "type": "string"
          },
          "previous_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Status"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "date",
          "change",
          "by"
        ],
        "title": "HistoryEntry",
        "type": "object"
      },
      "Kind": {
        "enum": [
          "error_meaning",
          "rate_limit",
          "breaking_change",
          "silent_behavior",
          "auth_quirk",
          "pagination",
          "sandbox_divergence",
          "deprecation",
          "availability",
          "schema_drift",
          "latency_profile"
        ],
        "title": "Kind",
        "type": "string"
      },
      "MatchedTemplate": {
        "properties": {
          "method": {
            "enum": [
              "GET",
              "HEAD",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "OPTIONS"
            ],
            "title": "Method",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "method",
          "path"
        ],
        "title": "MatchedTemplate",
        "type": "object"
      },
      "NoneKnown": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "none_known",
            "title": "Action",
            "type": "string"
          },
          "reason_kind": {
            "enum": [
              "vendor_side",
              "investigating",
              "by_design"
            ],
            "title": "Reason Kind",
            "type": "string"
          }
        },
        "required": [
          "action",
          "reason_kind"
        ],
        "title": "NoneKnown",
        "type": "object"
      },
      "Observed": {
        "properties": {
          "last_probe": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Probe"
          },
          "p50_latency_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "P50 Latency Ms"
          },
          "rate_limit_headers": {
            "items": {
              "type": "string"
            },
            "title": "Rate Limit Headers",
            "type": "array"
          },
          "status_distribution_30d": {
            "additionalProperties": {
              "type": "number"
            },
            "description": "Share of probe results per HTTP status over 30 days; empty until probes ran.",
            "title": "Status Distribution 30D",
            "type": "object"
          }
        },
        "required": [
          "status_distribution_30d",
          "p50_latency_ms",
          "last_probe",
          "rate_limit_headers"
        ],
        "title": "Observed",
        "type": "object"
      },
      "PaginateWith": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "paginate_with",
            "title": "Action",
            "type": "string"
          },
          "cursor_field": {
            "pattern": "^[A-Za-z0-9_.\\[\\]*$/-]{1,128}$",
            "title": "Cursor Field",
            "type": "string"
          },
          "page_size_max": {
            "maximum": 100000.0,
            "minimum": 1.0,
            "title": "Page Size Max",
            "type": "integer"
          },
          "param_name": {
            "pattern": "^[A-Za-z0-9_.\\[\\]*$/-]{1,128}$",
            "title": "Param Name",
            "type": "string"
          }
        },
        "required": [
          "action",
          "cursor_field",
          "param_name",
          "page_size_max"
        ],
        "title": "PaginateWith",
        "type": "object"
      },
      "PinSdkVersion": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "pin_sdk_version",
            "title": "Action",
            "type": "string"
          },
          "constraint": {
            "pattern": "^[A-Za-z0-9.,<>=!~^*|+-]{1,64}$",
            "title": "Constraint",
            "type": "string"
          },
          "ecosystem": {
            "enum": [
              "pypi",
              "npm"
            ],
            "title": "Ecosystem",
            "type": "string"
          },
          "package": {
            "pattern": "^(@[a-z0-9][a-z0-9._-]*/)?[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "title": "Package",
            "type": "string"
          }
        },
        "required": [
          "action",
          "package",
          "ecosystem",
          "constraint"
        ],
        "title": "PinSdkVersion",
        "type": "object"
      },
      "Provenance": {
        "additionalProperties": false,
        "properties": {
          "author": {
            "pattern": "^(bot|producer:[a-z0-9][a-z0-9-]{0,63}|human:[A-Za-z0-9][A-Za-z0-9-]{0,38})$",
            "title": "Author",
            "type": "string"
          },
          "created": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "title": "Created",
            "type": "string"
          },
          "history": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/HistoryEntry"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "History"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          }
        },
        "required": [
          "source",
          "author",
          "created"
        ],
        "title": "Provenance",
        "type": "object"
      },
      "ReducePayload": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "reduce_payload",
            "title": "Action",
            "type": "string"
          },
          "field": {
            "pattern": "^[A-Za-z0-9_.\\[\\]*$/-]{1,128}$",
            "title": "Field",
            "type": "string"
          },
          "max_bytes": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Bytes"
          },
          "max_items": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
