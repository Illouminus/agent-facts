# apifacts.dev — the apifacts check() API (D-091, 25.10.2026). Appended to /etc/caddy/Caddyfile by
# hand (ops/README.md → Caddy). DNS: A records apifacts.dev and www → illouminus (OVH zone, set by
# Edouard 25.10); facts.baillot.dev (the W8 address, *.baillot.dev wildcard) redirects here since
# 25.10.2026, the day of the first plugin release (v0.1.0 on PyPI points everything at apifacts.dev).
#
# No `log` directive on purpose: Caddy keeps no access log for these sites, so caller IPs never reach
# a disk (spec 03: never store or log raw IPs; uvicorn runs with --no-access-log for the same
# reason). Caddy does not trust an incoming X-Forwarded-For (no trusted_proxies here) and sends the
# caller's address itself; the API believes X-Forwarded-For only from 127.0.0.1/::1.
apifacts.dev {
	encode zstd gzip
	request_body {
		max_size 16KB
	}
	reverse_proxy 127.0.0.1:8795
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

www.apifacts.dev {
	redir https://apifacts.dev{uri} permanent
}

# Old address (W8, 20.10.2026). 308, not 301: a POST /v0/check sent here must stay a POST at
# apifacts.dev (301 lets clients replay it as GET).
facts.baillot.dev {
	redir https://apifacts.dev{uri} 308
}
