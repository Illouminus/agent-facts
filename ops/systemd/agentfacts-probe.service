# One probe tick (spec 04): due probes only, at most 50, results to var/results.jsonl.
# Kill switch: `touch %h/apps/agent-facts/ops/KILL` (or APIFACTS_KILL=1) → the tick exits before
# its first request. Probe keys are injected by the runner itself, by name (spec 04).
[Unit]
Description=apifacts probe tick (vantage illouminus)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/apps/agent-facts
ExecStart=%h/apps/agent-facts/.venv/bin/apifacts probe run --due --max 50 --vantage illouminus --root %h/apps/agent-facts
Nice=10
TimeoutStartSec=840
# Hardening (sec card 2026-10-23, D-089): seccomp and prctl only. Mount-namespace options
# (ProtectSystem, PrivateTmp, ReadWritePaths, InaccessiblePaths…) cannot work in user units on
# illouminus: AppArmor restricts unprivileged user namespaces (ops/README.md → Hardening).
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
