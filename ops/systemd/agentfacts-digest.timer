# Monday 08:00 Paris time (spec 08). Persistent: a Monday missed while the host was down runs at boot.
[Unit]
Description=apifacts weekly digest, Monday 08:00 Europe/Paris

[Timer]
OnCalendar=Mon *-*-* 08:00:00 Europe/Paris
Persistent=true
Unit=agentfacts-digest.service

[Install]
WantedBy=timers.target
