# IndexNow (spec 06): read the local API's /sitemap.xml, POST the URLs whose lastmod moved since
# the last accepted submission (state in var/indexnow.json) to api.indexnow.org in one batch.
# A refused submission exits 1 and is retried in full the next morning. Dry run by hand:
#   .venv/bin/python ops/indexnow.py --dry-run
[Unit]
Description=apifacts IndexNow submission (changed pages → api.indexnow.org)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/apps/agent-facts
ExecStart=%h/apps/agent-facts/.venv/bin/python %h/apps/agent-facts/ops/indexnow.py --state %h/apps/agent-facts/var/indexnow.json
TimeoutStartSec=120
# Hardening (sec card 2026-10-23, D-089): seccomp and prctl only. Mount-namespace options
# (ProtectSystem, PrivateTmp, ReadWritePaths, InaccessiblePaths…) cannot work in user units on
# illouminus: AppArmor restricts unprivileged user namespaces (ops/README.md → Hardening).
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
