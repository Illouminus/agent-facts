# Enabled 2026-10-20 (orchestrator, after W4 #10/#11 and repo setting allow_auto_merge). To switch on
# elsewhere, run a dry run on the host first:
#   .venv/bin/agentfacts quorum run --root . --db var/observations.sqlite --dry-run
#   .venv/bin/agentfacts bot publish --root . --dry-run
#   systemctl --user enable --now agentfacts-quorum.timer
# The bot needs git push + gh on the host and "Allow auto-merge" on the repo (W4 hand-over).
[Unit]
Description=agent-facts quorum + bot (spec 05)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/apps/agent-facts
Environment=AGENTFACTS_DB=%h/apps/agent-facts/var/observations.sqlite
# gh lives in ~/.local/bin on illouminus; user units get a minimal PATH without it (2026-10-20)
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh -c '%h/apps/agent-facts/.venv/bin/agentfacts quorum run --root %h/apps/agent-facts --db %h/apps/agent-facts/var/observations.sqlite && %h/apps/agent-facts/.venv/bin/agentfacts bot publish --root %h/apps/agent-facts'
Nice=10
TimeoutStartSec=1800
