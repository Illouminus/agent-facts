# check() API (spec 03) on illouminus, behind Caddy at apifacts.dev (ops/Caddyfile.facts).
# One worker: rate limits live in this process's memory and the store is one sqlite connection.
# --no-access-log: uvicorn's access log prints client IPs; spec 03 never stores or logs raw IPs.
# Install: systemctl --user link %h/apps/agent-facts/ops/systemd/agentfacts-api.service (ops/README.md)
[Unit]
Description=apifacts check() API (uvicorn, 127.0.0.1:8795)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/agent-facts
Environment=APIFACTS_REPO=%h/apps/agent-facts
Environment=APIFACTS_DB=%h/apps/agent-facts/var/observations.sqlite
Environment=APIFACTS_TRUSTED_PROXIES=127.0.0.1,::1
ExecStart=%h/apps/agent-facts/.venv/bin/uvicorn apifacts.api.app:app --workers 1 --no-access-log --host 127.0.0.1 --port 8795
Restart=on-failure
RestartSec=5
# Hardening (sec card 2026-10-23, D-089): seccomp and prctl only. Mount-namespace options
# (ProtectSystem, PrivateTmp, ReadWritePaths, InaccessiblePaths…) cannot work in user units on
# illouminus: AppArmor restricts unprivileged user namespaces (ops/README.md → Hardening).
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
