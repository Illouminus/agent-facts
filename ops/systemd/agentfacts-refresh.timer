# 03:00 Paris time, once a day (spec 04). Persistent: a night missed while the host was down runs
# at boot. Enable: systemctl --user enable --now agentfacts-refresh.timer
[Unit]
Description=agent-facts daily evidence refresh, 03:00 Europe/Paris

[Timer]
OnCalendar=*-*-* 03:00:00 Europe/Paris
Persistent=true
Unit=agentfacts-refresh.service

[Install]
WantedBy=timers.target
