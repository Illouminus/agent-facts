{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apifacts.dev/schema/v0/service.schema.json",
  "title": "Service registration",
  "description": "services/<service>.yaml (docs/specs/01-fact-schema.md). Registered templates are the only paths check() stores observations for and probes may call.",
  "type": "object",
  "required": ["key", "name", "hosts", "surfaces", "dimensions", "tos"],
  "additionalProperties": false,
  "properties": {
    "key": {"$ref": "fact.schema.json#/$defs/slug"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "hosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/hostname"}
    },
    "doc_hosts": {
      "description": "Vendor documentation hosts (e.g. docs.stripe.com). URLs inside fixes must be on hosts or doc_hosts, or a subdomain of one.",
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/hostname"}
    },
    "surfaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "http": {"$ref": "#/$defs/http_surface"},
        "sdk": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["ecosystem", "package"],
            "additionalProperties": false,
            "properties": {
              "ecosystem": {"$ref": "fix.schema.json#/$defs/ecosystem"},
              "package": {"$ref": "fix.schema.json#/$defs/package"}
            }
          }
        }
      }
    },
    "dimensions": {
      "type": "object",
      "required": ["env"],
      "additionalProperties": false,
      "properties": {
        "env": {
          "description": "Base URL per environment the service offers.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "prod": {"$ref": "fix.schema.json#/$defs/https_url"},
            "sandbox": {"$ref": "fix.schema.json#/$defs/https_url"}
          }
        },
        "account_state": {
          "description": "The account states facts and probes of this service may name (besides `any`).",
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "fact.schema.json#/$defs/dimension_value"}
        }
      }
    },
    "auth": {"$ref": "#/$defs/auth"},
    "tos": {
      "type": "object",
      "required": ["automated_access", "publish_measurements", "source"],
      "additionalProperties": false,
      "properties": {
        "automated_access": {"enum": ["allowed"], "x-error-codes": {"enum": "tos_not_allowed"}},
        "publish_measurements": {"enum": ["allowed"], "x-error-codes": {"enum": "tos_not_allowed"}},
        "source": {"$ref": "fix.schema.json#/$defs/https_url"}
      }
    },
    "probe_budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "per_template_seconds": {
          "description": "Invariant 6: at most one request per 5 minutes per (service, template, vantage); overrides may only be slower.",
          "type": "integer",
          "minimum": 300,
          "default": 300,
          "x-error-codes": {"minimum": "budget_too_low"}
        }
      }
    }
  },
  "$defs": {
    "hostname": {
      "type": "string",
      "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}(?!\\n)$"
    },
    "http_surface": {
      "type": "object",
      "required": ["base_url", "templates"],
      "additionalProperties": false,
      "properties": {
        "base_url": {"$ref": "fix.schema.json#/$defs/https_url"},
        "templates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["method", "path"],
            "additionalProperties": false,
            "properties": {
              "method": {"$ref": "fix.schema.json#/$defs/http_method"},
              "path": {"$ref": "fix.schema.json#/$defs/path_template"}
            }
          }
        },
        "signal_fields": {
          "description": "Whitelist of response fields check() may extract into a signal.",
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9_./-]{1,64}(?!\\n)$"}
        },
        "jsonrpc": {
          "description": "The service's JSON-RPC 2.0 endpoint (a registered POST template) and the methods on it that only read state. A prod probe may POST one JSON-RPC request to this path only, with one of these methods (prod probes are otherwise GET/HEAD only).",
          "type": "object",
          "required": ["path", "read_methods"],
          "additionalProperties": false,
          "properties": {
            "path": {"$ref": "fix.schema.json#/$defs/path_template"},
            "read_methods": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}(?!\\n)$"}
            }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["none", "bearer", "basic", "header", "query", "path_prefix", "google_service_account", "oauth_refresh_token"]
        },
        "key_name": {
          "description": "Name of ~/.private_keys/<key_name>.key on the probe runner; never a value.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(?!\\n)$"
        },
        "env": {"$ref": "fix.schema.json#/$defs/env"},
        "header_name": {"$ref": "fix.schema.json#/$defs/header_name"},
        "param_name": {"$ref": "fix.schema.json#/$defs/identifier"},
        "path_prefix": {
          "description": "path_prefix: what the runner puts before every keyed path, the key in place of {key} (Telegram: /bot{key}). Registered templates never contain it.",
          "type": "string",
          "pattern": "^(?!(.*/)?\\.{1,2}/)(/[A-Za-z0-9_.~-]+)*/[A-Za-z0-9_.~-]*\\{key\\}(?!\\n)$"
        },
        "scopes": {
          "description": "google_service_account: OAuth scopes of the access token the runner mints from the service-account JSON key.",
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^https://www\\.googleapis\\.com/auth/[a-z0-9._-]{1,64}(?!\\n)$"}
        },
        "instance_hosts": {
          "description": "oauth_refresh_token: hosts (or their subdomains) where the auth URL's host and the token's instance may be; tenant domains live here, not in the service's hosts.",
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/hostname"}
        },
        "token_path": {
          "description": "oauth_refresh_token: path of the token endpoint on the auth URL's host (Salesforce: /services/oauth2/token).",
          "type": "string",
          "pattern": "^(?!.*/\\.{1,2}(/|$))(/[A-Za-z0-9_.~-]+){1,8}(?!\\n)$"
        }
      },
      "allOf": [
        {
          "description": "A keyless service may declare its scheme without key_name and env (auth: invalid probes send a fake constant in it); the minting kinds always need a key file.",
          "if": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["google_service_account", "oauth_refresh_token"]}}},
          "then": {"required": ["key_name", "env"]}
        },
        {"dependentRequired": {"key_name": ["env"], "env": ["key_name"]}},
        {
          "if": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "path_prefix"}}},
          "then": {"required": ["path_prefix"]},
          "else": {"not": {"required": ["path_prefix"]}}
        },
        {
          "if": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "google_service_account"}}},
          "then": {"required": ["scopes"]},
          "else": {"not": {"required": ["scopes"]}}
        },
        {
          "if": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "oauth_refresh_token"}}},
          "then": {"required": ["token_path", "instance_hosts"]},
          "else": {"allOf": [{"not": {"required": ["token_path"]}}, {"not": {"required": ["instance_hosts"]}}]}
        },
        {
          "if": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "header"}}},
          "then": {"required": ["header_name"]}
        },
        {
          "if": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "query"}}},
          "then": {"required": ["param_name"]}
        }
      ]
    }
  }
}
